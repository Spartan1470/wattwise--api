# Copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 0 desactiva la llamada a Gemini y usa el fallback determinístico.
WATTWISE_ENABLE_GEMINI=1

# Opcional. Por defecto se usan las rutas del repo.
WATTWISE_RAG_INDEX=data/rag_index.json
WATTWISE_ML_MODEL=models/wattwise_ml.joblib
WATTWISE_NORMATIVA=data/normativa_colombia.json
